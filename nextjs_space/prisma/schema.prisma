generator client {
    provider = "prisma-client-js"
    binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
    output = "/home/ubuntu/budget_app/nextjs_space/node_modules/.prisma/client"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model Account {
  id          String   @id @default(cuid())
  name        String
  type        String   // BANK, CREDIT_CARD, CASH, OTHER
  balance     Float    @default(0)
  currency    String   @default("TRY")
  bankName    String?  // Banka adı
  color       String   @default("#10B981")
  icon        String   @default("wallet")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  transactions Transaction[]
  installments Installment[]
  creditCards  CreditCard[]
  plannedPayments PlannedPayment[]
  subscriptions Subscription[]

  @@index([type])
}

model CreditCard {
  id              String   @id @default(cuid())
  name            String
  cardNumber      String?  // Son 4 hane
  cardNetwork     String   @default("VISA") // VISA, MASTERCARD, TROY, OTHER
  cardTier        String   @default("NORMAL") // NORMAL, GOLD, PLATINUM, PREMIUM
  limitAmount     Float    @default(0)
  usedAmount      Float    @default(0)
  interestRate    Float    @default(0)
  billingDay      Int      @default(1)  // Hesap kesim günü
  paymentDay      Int      @default(10) // Ödeme günü
  autoPayment     Boolean  @default(false)
  accountId       String
  account         Account  @relation(fields: [accountId], references: [id])
  color           String   @default("#3B82F6")
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([accountId])
}

model PlannedPayment {
  id          String   @id @default(cuid())
  description String
  amount      Float
  type        String   @default("EXPENSE") // INCOME, EXPENSE
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id])
  accountId   String
  account     Account  @relation(fields: [accountId], references: [id])
  dueDate     DateTime
  isRecurring Boolean  @default(false)
  frequency   String?  // WEEKLY, MONTHLY, YEARLY
  isPaid      Boolean  @default(false)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([dueDate])
  @@index([isPaid])
}

model Subscription {
  id          String   @id @default(cuid())
  name        String
  amount      Float
  frequency   String   @default("MONTHLY") // MONTHLY, YEARLY
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id])
  accountId   String
  account     Account  @relation(fields: [accountId], references: [id])
  startDate   DateTime
  nextPayDate DateTime
  color       String   @default("#F59E0B")
  isActive    Boolean  @default(true)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive])
  @@index([nextPayDate])
}

model Budget {
  id          String   @id @default(cuid())
  name        String
  amount      Float    // Bütçe limiti
  spent       Float    @default(0)
  period      String   @default("MONTHLY") // WEEKLY, MONTHLY
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id])
  startDate   DateTime
  endDate     DateTime
  color       String   @default("#10B981")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive])
  @@index([period])
}

model Category {
  id          String   @id @default(cuid())
  name        String
  type        String   // INCOME, EXPENSE
  icon        String   @default("tag")
  color       String   @default("#6366F1")
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  transactions Transaction[]
  plannedPayments PlannedPayment[]
  subscriptions Subscription[]
  budgets     Budget[]

  @@index([type])
}

model Transaction {
  id          String   @id @default(cuid())
  type        String   // INCOME, EXPENSE, TRANSFER
  amount      Float
  description String
  date        DateTime
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id])
  accountId   String
  account     Account  @relation(fields: [accountId], references: [id])
  vendorId    String?
  vendor      Vendor?  @relation(fields: [vendorId], references: [id])
  documentId  String?
  document    Document? @relation(fields: [documentId], references: [id])
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([date])
  @@index([type])
  @@index([categoryId])
  @@index([accountId])
}

model DebtCredit {
  id          String   @id @default(cuid())
  type        String   // DEBT, CREDIT (Borç, Alacak)
  personName  String
  amount      Float
  remainingAmount Float
  description String?
  dueDate     DateTime?
  status      String   @default("ACTIVE") // ACTIVE, PAID, OVERDUE
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  payments    DebtPayment[]

  @@index([type])
  @@index([status])
}

model DebtPayment {
  id          String   @id @default(cuid())
  debtCreditId String
  debtCredit  DebtCredit @relation(fields: [debtCreditId], references: [id], onDelete: Cascade)
  amount      Float
  date        DateTime
  note        String?
  createdAt   DateTime @default(now())
}

model Installment {
  id              String   @id @default(cuid())
  description     String
  totalAmount     Float
  installmentCount Int
  paidCount       Int      @default(0)
  monthlyAmount   Float
  startDate       DateTime
  accountId       String
  account         Account  @relation(fields: [accountId], references: [id])
  vendorId        String?
  vendor          Vendor?  @relation(fields: [vendorId], references: [id])
  status          String   @default("ACTIVE") // ACTIVE, COMPLETED
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
  @@index([accountId])
}

model Vendor {
  id          String   @id @default(cuid())
  name        String
  phone       String?
  email       String?
  address     String?
  balance     Float    @default(0) // positive=alacak, negative=borç
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  transactions Transaction[]
  installments Installment[]

  @@index([name])
}

model Document {
  id              String   @id @default(cuid())
  fileName        String
  fileType        String   // IMAGE, PDF
  cloudStoragePath String
  isPublic        Boolean  @default(false)
  extractedData   String?  // JSON string of OCR results
  status          String   @default("PENDING") // PENDING, PROCESSED, FAILED
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  transactions    Transaction[]
}
